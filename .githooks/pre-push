#!/bin/sh
# Only 'main' may be pushed onto refs/heads/main.
# Pushing other branches to their own remote refs is allowed.
blocked=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_ref" != "refs/heads/main" ]; then
    blocked=1
  fi
done
if [ "$blocked" = "1" ]; then
  echo "BLOCKED: only 'main' can be pushed to 'main'." >&2
  exit 1
fi
exit 0
